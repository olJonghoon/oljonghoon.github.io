---
import { Icon } from 'astro-icon/components';
import {
	Button,
	StickyTextImageSection,
} from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'About',
	description: 'About Me | Jonghoon Lee',
};
---

<Layout {seo}>
	<StickyTextImageSection>
		<div slot="text-container" style="margin-left: 2rem; line-height: 1.8;">
			<h2 style= "font-size: 2rem;">Welcome</h2>
			<p>
				I am an 
				<a href="https://www.tse.nthu.edu.tw/member/87?category_alias=faculty" target="_blank" rel="noreferrer">
					Assistant Professor</a>
				and a 
				<a href="https://yushan.project.edu.tw/TopTalent/EN" target="_blank" rel="noreferrer">
					Yushan Young Fellow</a>
				at
				<a href="https://www.tse.nthu.edu.tw/" target="_blank" rel="noreferrer">
					the Taipei School of Economics and Political Science</a>,
				<a href="https://nthu-en.site.nthu.edu.tw/" target="_blank" rel="noreferrer">
					National Tsing Hua University</a>.
				Previously, I was as a Postdoctoral Fellow at Arkansas State University
				I earned my Ph.D. in Political Science at the Department of 
				Political Science at Texas A&M University.
			</p>
			<p>
				Politics involves strategic interactions among actors who hold 
				different beliefs, preferences, interests, and goals. These actors 
				compete with one another within existing institutions while also 
				seeking to reshape those rules to their advantage. I study how 
				policy outcomes emerge from these strategic interactions. I am 
				especially interested in judicial institutions as arenas and instruments 
				of political competition.
				My work has been invited for publication at the <em>Journal of Public Administration 
				Research and Theory</em>, the <em>Journal of Theoretical Politics</em>, 
				<em>Business and Politics</em>, and <em>Social Science Quarterly</em>.
			</p>
		</div>
		<div slot="btns-container" style="margin-left: 2rem;">
			<Button href="mailto:oljonghoon@gmail.com">
					<Icon name="ic:baseline-mail" />
			</Button>
		</div>
		<picture slot="image-container" style="margin-left: 2rem;">
			<img
			  src="/assets/images/landing-1/Jonghoon_Headshot.jpg"
			  alt="Astro Odyssey"
			  loading="lazy"
			/>
		</picture>
	</StickyTextImageSection>
</Layout>
